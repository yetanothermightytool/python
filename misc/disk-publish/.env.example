# Veeam Backup & Replication REST API
VBR_HOST=vbr01.contoso.local
VBR_PORT=9419
VBR_USER=CONTOSO\Administrator
VBR_PASSWORD=SuperGeheim123
VBR_API_VERSION=1.3-rev2

# true = ignore self-signed certificates
VBR_SKIP_SSL_VERIFY=true

# Disk publish defaults (override with --mount-server / --allowed-ips)
MOUNT_SERVER=
# IPs allowed to access the iSCSI target, comma separated
ALLOWED_IPS=10.0.0.10
PUBLISH_REASON=Disk publish via Data Integration API
